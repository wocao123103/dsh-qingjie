      "zh": "混合执行",
      "alt": [
        "具体-符号执行"
      ],
      "domain": "程序分析",
      "note": "中文论文多用「混合执行」；首次出现建议写「混合执行（concolic execution）」。不要译成「具体执行」。"
    },
    {
      "en": "fuzzing",
      "zh": "模糊测试",
      "alt": [
        "模糊化测试"
      ],
      "domain": "软件安全",
      "note": "「模糊测试」是规范译法，不要写「模糊化」。"
    },
    {
      "en": "greybox fuzzing",
      "zh": "灰盒模糊测试",
      "alt": [
        "灰箱模糊测试"
      ],
      "domain": "软件安全",
      "note": "greybox 统一译「灰盒」，与 black-box/white-box 保持体例一致。"
    },
    {
      "en": "reachability roadblock",
      "zh": "可达性障碍",
      "alt": [
        "可达性受阻点"
      ],
      "domain": "软件安全",
      "note": "roadblock 直译「路障」太口语；学术语境用「障碍/受阻点」。"
    },
